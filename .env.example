SPRING_DATASOURCE_PASSWORD=projectkg

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGIN=http://localhost:3000

NOTION_BASE_URL=https://api.notion.com/v1
NOTION_TOKEN=
